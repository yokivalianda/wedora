# Wedora — Supabase Integration Configuration
# Salin berkas ini sebagai .env.local dan isi nilai di bawah ini dari Dasbor Supabase Anda

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Demo Account Configuration
# These control which account is treated as the demo account.
# The demo account sees pre-populated mock/sample wedding data.
# If unset, no account will be treated as demo and all users see empty state.
NEXT_PUBLIC_DEMO_EMAIL=demo@wedora.app
NEXT_PUBLIC_DEMO_PASSWORD=your-demo-password
